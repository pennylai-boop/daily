# 天天 daily 環境變數範本
#
# 本機：複製成 .env.local 再填值（.env.local 已被 .gitignore 忽略）。
# GCP：機密值放 Secret Manager，再掛成 Cloud Run 的環境變數，不要烤進映像檔。
#
# 目前前端的資料層還是 localStorage（src/lib/storage.ts），下面的變數是接上
# Supabase 與 LINE 之後才會被讀取。標了 NEXT_PUBLIC_ 的會被打包進瀏覽器，
# 其餘只在伺服器端（Route Handler、Server Action、排程）使用。
#
# 帳號流程：LINE 登入即完成綁定。登入拿到的 userId 就是 Messaging API 推播要用的 userId，
# 不需要再做一次綁定流程（前提是兩個 channel 在同一個 provider 底下，見下面說明）。


# ─────────────────────────────────────────────
# 應用程式
# ─────────────────────────────────────────────

# 對外網址。OAuth 轉回來的 redirectTo 與分享連結都以此為基準。
# 本機用 http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://daily.introvista.ai


# ─────────────────────────────────────────────
# Supabase
# 取得位置：Dashboard → Project Settings → API Keys
# ─────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# 給瀏覽器用的低權限金鑰，可以公開，權限由 RLS 決定。
# 舊專案若還沒建新金鑰，這格填 anon key（JWT 格式）也能運作。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 伺服器端專用，會繞過 RLS：絕對不要加 NEXT_PUBLIC_ 前綴，也不要進到前端程式碼。
# 舊專案對應的是 service_role key。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# 只有跑 migration 或 SQL 工具才需要。Project Settings → Database → Connection string。
# Cloud Run 這種會頻繁擴縮的環境請用 pooler（埠號 6543）而不是直連 5432。
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres


# ─────────────────────────────────────────────
# LINE 登入
#
# Supabase 沒有內建 LINE provider，要註冊成 Custom OAuth Provider。設定細節與一次性的
# createProvider 腳本見 README 的「部署規劃」，這裡只記三個一定會踩到的點：
#
# 1. 要選 OAuth2（手動填端點），不要選 Auto-discovery (OIDC)。LINE 的 id_token 是用
#    channel secret 以 HS256 簽章，Supabase 的 OIDC 流程會去 JWKS 驗非對稱簽章，驗不過。
# 2. /v2/profile 回的是 userId 而不是 sub，要用 attribute_mapping 對過去，
#    否則登入最後會失敗在 "missing provider id"。
# 3. LINE Login channel 與下面的 Messaging API channel 必須在「同一個 provider」底下，
#    userId 才會是同一組值，登入拿到的 id 才推得動訊息。
#
# LINE 後台的 Callback URL 填 https://<專案>.supabase.co/auth/v1/callback
# 前端：supabase.auth.signInWithOAuth({ provider: "custom:line" })
# ─────────────────────────────────────────────

# channel ID 與 secret 最終是存在 Supabase，這兩格只有跑 createProvider 腳本時會讀。
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LIFF app 的 ID（Login channel → LIFF 分頁新增，Endpoint URL 指向本站）。
# 用來叫出 liff.shareTargetPicker()，讓使用者直接在 LINE 的好友清單裡挑分享對象。
NEXT_PUBLIC_LIFF_ID=


# ─────────────────────────────────────────────
# LINE 推送（把每日紀錄送到群組或個人）
# 同一個 provider 底下的 Messaging API channel
#
# 目前產品不做伺服器推送：分享一律由使用者在紀錄頁按下送出、經系統分享面板選 LINE，
# 訊息從使用者自己的帳號發出，不計入官方帳號的月額度。這兩個值先留著給日後評估用。
#
# 真的要改成伺服器推送前先算成本：push 是按「收得到訊息的人數」計費，推一個 5 人群組
# 就是 5 則，台灣免費方案每月只有 200 則且不可加購，用完直接發送失敗。
# 推播的前提也是對方已加官方帳號為好友。在 Login channel 的 Basic settings 綁定官方帳號後，
# 讓 Supabase 的 authorization_params 帶 bot_prompt=aggressive，使用者登入時就會被引導加好友。
# ─────────────────────────────────────────────

# 驗證 webhook 簽章用（使用者加好友、把官方帳號邀進群組時會打進來）
LINE_MESSAGING_CHANNEL_SECRET=
# 推送訊息用，長期有效，只能放在伺服器端
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=


# ─────────────────────────────────────────────
# 贊助金流：PAYUNi（統一金流）
#
# 「支持」頁走整合式支付頁 UNiPaypage (UPP)：伺服器組好 EncryptInfo／HashInfo，
# 由瀏覽器 form post 到 PAYUNi 的付款頁，卡號完全不經過本站。
# 值取自 PAYUNi 後台的「商店串接資訊」。
#
# 後台的通知網址要對得上（以 NEXT_PUBLIC_SITE_URL 為基準，只支援 80／443）：
#   ReturnURL /api/support/return   前景導回，只用來顯示結果
#   NotifyURL /api/support/notify   背景通知，入帳與寄感謝信以它為準
# ─────────────────────────────────────────────

# sandbox＝測試區，production＝正式區。沒填視為 sandbox。
PAYUNI_ENV=sandbox

PAYUNI_MER_ID=
# Hash Key 必須 32 字元、Hash IV 必須 16 字元（AES-256-GCM 的 key／iv 長度）。
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=


# ─────────────────────────────────────────────
# 電子發票：SmilePay 速買配（購買卜卦點數用）
#
# 贊助不開發票（不是商品銷售）；購買卜卦點數會開。
# 金流是 PAYUNi、發票是 SmilePay，兩套憑證完全不同，不可混用。
# 開票時機在 PAYUNi 的 NotifyURL 確認付款成功之後（見 docs/smilepay-api.md）。
# 未設定時付款與點數照樣完成，只是發票沒開，原因記在訂單的 invoice_error。
# ─────────────────────────────────────────────

# test＝測試區，production＝正式區。沒填視為 test。
SMILEPAY_ENV=test

# 速買配後台核發的電子發票帳號與驗證碼。
SMILEPAY_GRVC=
SMILEPAY_VERIFY_KEY=


# ─────────────────────────────────────────────
# 感謝信與兌換碼：Resend（選填）
#
# 贊助付款成功後寄感謝信；購買點數則寄兌換碼。
# 未設定 RESEND_API_KEY 時只記伺服器 log，付款流程仍可完成。
# ─────────────────────────────────────────────

RESEND_API_KEY=
# 例如：天天 daily <noreply@your-domain.com>
SUPPORT_EMAIL_FROM=
# 使用建議會寄到這個信箱；未填則嘗試從 SUPPORT_EMAIL_FROM 解析。
SUPPORT_INBOX_EMAIL=


# ─────────────────────────────────────────────
# 數字卜卦：Gemini（選填）
#
# 卜卦頁（/divination）用 Gemini 解讀起卦結果。
# 未設定 GEMINI_API_KEY 時仍會顯示卦象，只是沒有 AI 解讀文字。
# 取得位置：https://aistudio.google.com/apikey
# ─────────────────────────────────────────────

GEMINI_API_KEY=
# 未填預設用 gemini-2.5-flash。
GEMINI_MODEL=


# ─────────────────────────────────────────────
# GCP
# ─────────────────────────────────────────────

GOOGLE_CLOUD_PROJECT=daily-506100
GCP_REGION=asia-east1

# Cloud Run 會自己注入 PORT，Next.js 必須監聽它；本機開發不用設。
# PORT=3000
